{
  "name": "way2cure-marketplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Way2Cure Senior Marketplace - frontend (home care + medicines, devices, daily care and subscriptions for seniors).",
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_ENV=production vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "lighthouse": "npx --yes lighthouse@12.2.1 http://127.0.0.1:4173/ --form-factor=mobile --only-categories=performance,accessibility,best-practices,seo --output=json --output=html --output-path=docs/lighthouse/home --chrome-flags=\"--headless=new\""
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "motion": "^11.18.2",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "playwright-core": "^1.48.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
